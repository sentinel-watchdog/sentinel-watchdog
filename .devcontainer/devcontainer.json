{
  // Sentinel Watchdog development container (VS Code Dev Containers, Zed).
  // The Docker engine is the current context: `docker context use <name>` or
  // DOCKER_CONTEXT. On a remote engine (containers01) the local folder cannot
  // be mounted: see docs/development.md, "Editors and dev container".
  "name": "sentinel-watchdog",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "dev",
  "containerEnv": {
    "CGO_ENABLED": "0",
    "GOTOOLCHAIN": "local",
    // AI agents run inside the container (Zed's agent panel, VS Code
    // extensions) and keep login, settings and sessions here: named
    // volumes, so a rebuild keeps them and a remote engine works too.
    // CLAUDE_CONFIG_DIR also moves ~/.claude.json into the volume.
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    "CODEX_HOME": "/home/dev/.codex"
  },
  "mounts": [
    "source=sentinel-watchdog-claude,target=/home/dev/.claude,type=volume",
    "source=sentinel-watchdog-codex,target=/home/dev/.codex,type=volume"
  ],
  "postCreateCommand": "go mod download",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "editorconfig.editorconfig"]
    }
  }
}
