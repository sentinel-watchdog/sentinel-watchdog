#!/bin/sh
# sentinel-watchdog rpm %postun (D-102). $1 is the number of instances left:
# 0 on erase, when systemd reloads after the unit file went away; on an
# upgrade the new %post has already reloaded. Never touches
# /var/lib/sentinel (state and audit log) or the group; rpm keeps a modified
# sentinel.yaml as .rpmsave.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

case "${1:-}" in
	'' | *[!0-9]*)
		echo "sentinel-watchdog %postun: not an instance count: '${1:-}'" >&2
		exit 1
		;;
esac
[ "$1" -eq 0 ] || exit 0
[ ! -d /run/systemd/system ] || systemctl daemon-reload
